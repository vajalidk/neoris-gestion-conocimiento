    <rdfs:label xml:lang="es">Nube (servidores y bases de datos)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne2276df81047490cbb8cc225c85476b7">
    <rdf:first rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#DocumentacionTecnica"/>
    <rdf:rest rdf:nodeID="N39eed1e8fe3d451994e1dec2d97dd5bd"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#Doc_PRY_004">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#LeccionAprendida"/>
    <rdfs:label xml:lang="es">PRY-004: Minuta de reunión de arranque con el cliente</rdfs:label>
    <nx:idDocumento>PRY-004</nx:idDocumento>
    <nx:titulo xml:lang="es">Minuta de reunión de arranque con el cliente</nx:titulo>
    <nx:texto xml:lang="es">En la reunión de arranque se presentaron los equipos, el alcance y el calendario. El cliente pidió reportes de avance cada semana. Se definieron los responsables de cada área. Quedó pendiente que el cliente envíe los accesos a sus sistemas.</nx:texto>
  </rdf:Description>
