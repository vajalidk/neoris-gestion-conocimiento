  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#Doc_PRY_003">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#LeccionAprendida"/>
    <rdfs:label xml:lang="es">PRY-003: Reporte de avance semanal del proyecto de tienda en línea</rdfs:label>
    <nx:idDocumento>PRY-003</nx:idDocumento>
    <nx:titulo xml:lang="es">Reporte de avance semanal del proyecto de tienda en línea</nx:titulo>
    <nx:texto xml:lang="es">Esta semana se terminó el módulo de carrito y se empezaron las pruebas. El proyecto va en tiempo pero con un riesgo en la integración de pagos. Se acordó con el cliente una reunión para revisar ese riesgo. El avance general es del sesenta por ciento.</nx:texto>
    <nx:documenta rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#ProyectoTiendaEnLinea"/>
    <nx:registra rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#RiesgoIntegracionPagos"/>
  </rdf:Description>
