  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#Doc_SOP_008">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#SolucionDeTicket"/>
    <rdfs:label xml:lang="es">SOP-008: Solución: usuario bloqueado por intentos fallidos</rdfs:label>
    <nx:idDocumento>SOP-008</nx:idDocumento>
    <nx:titulo xml:lang="es">Solución: usuario bloqueado por intentos fallidos</nx:titulo>
    <nx:texto xml:lang="es">El usuario quedó bloqueado después de tres intentos fallidos de contraseña. El agente verifica la identidad del usuario y desbloquea la cuenta. Después le pide cambiar la contraseña. Este es uno de los tickets más comunes de la mesa de ayuda.</nx:texto>
    <nx:documenta rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#SolucionDesbloquearCuenta"/>
    <nx:describe rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#TicketCuentaBloqueada"/>
  </rdf:Description>
