    <rdfs:label xml:lang="es">Solución: corregir el pedido y reiniciar la interfaz</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#SistemaTiendaEnLinea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
