  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#ConsultorEjemplo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#Empleado"/>
    <rdfs:label xml:lang="es">Consultor (ejemplo)</rdfs:label>
    <nx:perteneceA rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#AreaSoporteTecnico"/>
    <nx:trabajaEn rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#ProyectoTiendaEnLinea"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#Doc_SOP_006">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#SolucionDeTicket"/>
    <rdfs:label xml:lang="es">SOP-006: Solución: correo de notificaciones no llega al cliente</rdfs:label>
    <nx:idDocumento>SOP-006</nx:idDocumento>
    <nx:titulo xml:lang="es">Solución: correo de notificaciones no llega al cliente</nx:titulo>
    <nx:texto xml:lang="es">Los correos automáticos de confirmación no llegaban a los clientes. Se encontró que caían en la carpeta de spam. Se configuró el registro SPF del dominio y los correos empezaron a llegar. Documentar el caso para clientes con el mismo proveedor de correo.</nx:texto>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#Doc_POL_006">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#PoliticaInterna"/>
    <rdfs:label xml:lang="es">POL-006: Proceso de incorporación de nuevos empleados</rdfs:label>
    <nx:idDocumento>POL-006</nx:idDocumento>
    <nx:titulo xml:lang="es">Proceso de incorporación de nuevos empleados</nx:titulo>
    <nx:texto xml:lang="es">El primer día el nuevo empleado recibe su equipo, sus accesos y una plática de bienvenida. La primera semana toma los cursos de seguridad y de la metodología de trabajo. Se le asigna un mentor que le ayuda a conocer los proyectos y las herramientas.</nx:texto>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#Doc_PRY_002">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#LeccionAprendida"/>
    <rdfs:label xml:lang="es">PRY-002: Plantilla de estimación de tiempos y costos</rdfs:label>
    <nx:idDocumento>PRY-002</nx:idDocumento>
    <nx:titulo xml:lang="es">Plantilla de estimación de tiempos y costos</nx:titulo>
    <nx:texto xml:lang="es">La plantilla ayuda a estimar cuánto tiempo y dinero cuesta un proyecto. Se llena por fases: análisis, desarrollo, pruebas y salida a producción. Usa datos de proyectos pasados parecidos. El líder de proyecto la revisa con el cliente antes de firmar.</nx:texto>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N634d1965de094bb2b7e4e7a50a96b286">
    <rdf:first rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#PoliticaInterna"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#Doc_PRY_007">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#LeccionAprendida"/>
    <rdfs:label xml:lang="es">PRY-007: Cierre de proyecto y entrega al cliente</rdfs:label>
    <nx:idDocumento>PRY-007</nx:idDocumento>
    <nx:titulo xml:lang="es">Cierre de proyecto y entrega al cliente</nx:titulo>
    <nx:texto xml:lang="es">Al cerrar el proyecto se entrega la documentación, los accesos y el manual de usuario. El cliente firma el acta de aceptación. El equipo hace una reunión de lecciones aprendidas. El soporte pasa a la mesa de ayuda con toda la información del sistema.</nx:texto>
  </rdf:Description>
