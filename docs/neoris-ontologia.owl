  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#ClienteRetail">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#Cliente"/>
