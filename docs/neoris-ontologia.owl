    <rdfs:label xml:lang="es">Tienda en línea</rdfs:label>
    <nx:implementa rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#SistemaTiendaEnLinea"/>
    <nx:tieneRiesgo rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#RiesgoIntegracionPagos"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#Solucion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">Solución</rdfs:label>
    <rdfs:comment xml:lang="es">Forma de resolver un ticket o un incidente.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#ConceptoDelDominio"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#Incidente">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">Incidente o falla</rdfs:label>
    <rdfs:comment xml:lang="es">Falla en un sistema, como una caída del servidor.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#ConceptoDelDominio"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#Doc_INF_008">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#ReporteDeIncidente"/>
    <rdfs:label xml:lang="es">INF-008: Control de costos de la nube</rdfs:label>
    <nx:idDocumento>INF-008</nx:idDocumento>
    <nx:titulo xml:lang="es">Control de costos de la nube</nx:titulo>
    <nx:texto xml:lang="es">Cada mes se revisa cuánto gasta cada cliente en la nube. Se apagan las máquinas de pruebas fuera del horario laboral. Se eliminan discos y respaldos que ya no se usan. El reporte de costos se comparte con el líder de proyecto.</nx:texto>
  </rdf:Description>
