    <nx:contrata rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#ProyectoTiendaEnLinea"/>
    <nx:abre rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#TicketCuentaBloqueada"/>
    <nx:abre rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#TicketPedidosSAP"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#Doc_INF_001">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#ReporteDeIncidente"/>
    <rdfs:label xml:lang="es">INF-001: Reporte de incidente: caída del servidor de producción</rdfs:label>
    <nx:idDocumento>INF-001</nx:idDocumento>
    <nx:titulo xml:lang="es">Reporte de incidente: caída del servidor de producción</nx:titulo>
    <nx:texto xml:lang="es">El servidor de producción dejó de responder por falta de memoria. El equipo de operaciones reinició el servicio y aumentó la memoria de la máquina virtual. La caída duró cuarenta minutos. Se agregó una alerta para avisar cuando la memoria pase del ochenta por ciento.</nx:texto>
    <nx:documenta rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#IncidenteCaidaServidor"/>
    <nx:describe rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#SistemaNube"/>
    <nx:seReutilizaEn rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#Doc_SOP_007"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#Organizacion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">Organización</rdfs:label>
    <rdfs:comment xml:lang="es">Empresa donde se implementa el sistema de gestión del conocimiento.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#Empleado">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">Consultor o empleado</rdfs:label>
    <rdfs:comment xml:lang="es">Persona que trabaja en Neoris.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#ConceptoDelDominio"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#Doc_SOP_002">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#SolucionDeTicket"/>
    <rdfs:label xml:lang="es">SOP-002: Solución: SAP muestra error al generar factura</rdfs:label>
    <nx:idDocumento>SOP-002</nx:idDocumento>
    <nx:titulo xml:lang="es">Solución: SAP muestra error al generar factura</nx:titulo>
    <nx:texto xml:lang="es">Al generar una factura en SAP aparece un error de autorización. El usuario no tenía el rol de facturación asignado. Se resolvió asignando el rol correcto desde la transacción de usuarios. Se recomienda revisar permisos antes de escalar el ticket.</nx:texto>
    <nx:describe rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#SistemaSAP"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#IncidenteCaidaServidor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#Incidente"/>
    <rdfs:label xml:lang="es">Incidente: caída del servidor por falta de memoria</rdfs:label>
    <nx:ocurreEn rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#SistemaNube"/>
    <nx:seResuelveCon rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#SolucionAumentarMemoria"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#Doc_DEV_006">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#DocumentacionTecnica"/>
    <rdfs:label xml:lang="es">DEV-006: Manual de despliegue de aplicaciones web</rdfs:label>
    <nx:idDocumento>DEV-006</nx:idDocumento>
    <nx:titulo xml:lang="es">Manual de despliegue de aplicaciones web</nx:titulo>
    <nx:texto xml:lang="es">Para desplegar una aplicación se construye la imagen, se corren las pruebas y se sube al ambiente de pruebas. Si todo pasa, se despliega a producción con el pipeline de integración continua. Después del despliegue se revisan los registros para confirmar que no hay errores.</nx:texto>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#Doc_INF_003">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#ReporteDeIncidente"/>
    <rdfs:label xml:lang="es">INF-003: Configuración de máquinas virtuales en la nube</rdfs:label>
    <nx:idDocumento>INF-003</nx:idDocumento>
    <nx:titulo xml:lang="es">Configuración de máquinas virtuales en la nube</nx:titulo>
    <nx:texto xml:lang="es">Las máquinas virtuales se crean con plantillas para que todas tengan la misma configuración. Se definen el tamaño, la red y las reglas de firewall. El acceso se da solo con llaves y nunca con contraseña. Cada máquina se etiqueta con el cliente y el ambiente.</nx:texto>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#SolucionDeTicket">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">Solución de ticket</rdfs:label>
    <rdfs:comment xml:lang="es">Soluciones a tickets y guías de la mesa de ayuda (SOP).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#Documento"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#Doc_POL_008">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#PoliticaInterna"/>
    <rdfs:label xml:lang="es">POL-008: Política de protección de datos personales</rdfs:label>
    <nx:idDocumento>POL-008</nx:idDocumento>
    <nx:titulo xml:lang="es">Política de protección de datos personales</nx:titulo>
    <nx:texto xml:lang="es">Los datos personales de clientes y empleados solo se usan para el fin autorizado. Se guardan en sistemas seguros y con acceso limitado. Las personas pueden pedir ver, corregir o borrar sus datos. Esta política sigue la ley de protección de datos personales.</nx:texto>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/vicente/ontologias/neoris#Documento">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="es">Documento</rdfs:label>
    <rdfs:comment xml:lang="es">Recurso de conocimiento explícito guardado en el repositorio.</rdfs:comment>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/vicente/ontologias/neoris#ConceptoDelDominio"/>
  </rdf:Description>
